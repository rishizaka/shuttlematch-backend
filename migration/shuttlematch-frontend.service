[Unit]
Description=ShuttleMatch Frontend
After=network.target shuttlematch.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /home/ubuntu/frontend/serve.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
